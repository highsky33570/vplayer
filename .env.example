# API
APP_ENV=local
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173
# User login Bearer token signing (must differ from CDN_SIGN_SECRET in production)
AUTH_SECRET=change-me-auth-secret
# false (default): POST /auth/register creates the user immediately, no SMTP.
# true: registration requires register/start → email code → register/verify.
# SMTP_* and EMAIL_CODE_PEPPER are required only when this is true.
EMAIL_VERIFICATION_ENABLED=false

# MySQL
MYSQL_DSN=vplayer:vplayer@tcp(127.0.0.1:3306)/vplayer?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloudflare R2 (S3-compatible, PRIVATE — migration/upload credentials only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Must match the CDNfly origin bucket; CDN URLs include /{R2_BUCKET}/...
R2_BUCKET=dongman
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# Do not use public r2.dev for production delivery
R2_PUBLIC_BASE=

# Browser-facing media delivery host. Do not hardcode temporary test hosts in code.
MEDIA_CDN_BASE_URL=https://media.example.com
CDN_BASE_URL=https://media.example.com
# How object keys are appended to MEDIA_CDN_BASE_URL:
#   bucket_prefix (default) → {base}/{R2_BUCKET}/{key}
#   object_key               → {base}/{key}
# Use object_key when the delivery host/custom domain already maps to the R2 bucket root.
MEDIA_CDN_PATH_MODE=bucket_prefix
# none = delivery host authenticates to private R2 (or public custom-domain mapping)
# legacy_hmac = VPlayer exp/sig on the delivery path
CDN_URL_AUTH_MODE=none
CDN_SIGN_SECRET=change-me
PLAY_TICKET_TTL_SEC=300

# HLS AES key material (rotate in production)
HLS_KEY_SECRET=change-me-hls-key-secret

# Admin
ADMIN_API_TOKEN=dev-admin-token

# OLEHDTV / MacCMS sync
# source mode: fixture | export_file | maccms_db | html_dump | maccms_recent
#
# maccms_recent — bounded page-1 recent discovery for cmd/syncincremental only.
#   - Use: go run ./cmd/syncincremental --limit 5   (CLI limit must be 1–20)
#   - Keep OLEHDTV_SYNC_ENABLED=false: the API in-process scheduler is the old/full sync path
#     and must not run maccms_recent (or any full catalog crawl).
#   - Production scheduling: separate syncincremental job (e.g. systemd oneshot + timer),
#     not OLEHDTV_SYNC_ENABLED / not vplayer-api.
#   - HTTP clamps still apply: delay>=1000ms, concurrency<=2, play enrichment capped.
#
OLEHDTV_SOURCE_MODE=fixture
OLEHDTV_FIXTURE_PATH=testdata/olehdtv_sample.json
OLEHDTV_EXPORT_PATH=
OLEHDTV_MACCMS_DSN=
# Offline MacCMS / SiteOne export directory (not committed)
OLEHDTV_HTML_DUMP_ROOT=testdata/maccms_html
# OLEHDTV_HTML_DUMP_ROOT=F:\VPlayer\data\olehdtv-html
# JSONL catalog import (categories.json + videos.jsonl + episodes.jsonl):
#   go run ./cmd/importolehdtv -root ../data/olehdtv-html -dry-run
#   go run ./cmd/importolehdtv -root ../data/olehdtv-html
# Public MacCMS base URL for maccms_recent / html_dump (set per environment; no secrets here)
OLEHDTV_PUBLIC_BASE_URL=https://maccms.local
# Must remain false — API scheduler ≠ syncincremental
OLEHDTV_SYNC_ENABLED=false
OLEHDTV_SYNC_INTERVAL_MINUTES=15
OLEHDTV_FETCH_POSTERS=false
OLEHDTV_LOCAL_OBJECTS_DIR=data/objects
OLEHDTV_MEDIA_PUBLIC_BASE=http://localhost:8080/media
OLEHDTV_REQUEST_DELAY_MS=1000
OLEHDTV_REQUEST_TIMEOUT_SECONDS=20
OLEHDTV_MAX_CONCURRENCY=2
OLEHDTV_MAX_RETRIES=3
# Optional opaque Cookie header for authorized OLEHDTV play-page enrichment only.
# Leave empty for anonymous public enrichment. Never commit a real value. Never log it.
# OLEHDTV_AUTH_COOKIE=
