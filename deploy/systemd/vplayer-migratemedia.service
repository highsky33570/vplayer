[Unit]
Description=VPlayer selective R2 media migration (bounded, limit 1)
Documentation=file:///opt/vplayer/deploy/systemd/README.md
After=network-online.target docker.service
Wants=network-online.target
# Match proven production syncincremental worker conventions (no dedicated Linux user).

[Service]
Type=oneshot
WorkingDirectory=/opt/vplayer
# Dotenv: cwd=/opt/vplayer → loadEnvFiles reads ./.env → /opt/vplayer/.env (no secrets in this unit).

# One episode per timer fire. Overlap protection is the app advisory lock (vplayer_media_migrate).
ExecStart=/opt/vplayer/backend/bin/migratemedia --execute --confirm=MIGRATE --limit 1 --trigger=timer

# CLI uses a 30-minute context; leave a small buffer for process teardown.
TimeoutStartSec=35m

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vplayer-migratemedia

[Install]
WantedBy=multi-user.target
