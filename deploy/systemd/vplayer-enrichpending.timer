[Unit]
Description=Run VPlayer pending playback enrichment every 3 hours (offset after discovery)
# Do NOT Requires= the oneshot — activating the timer must not start enrichment immediately.

[Timer]
# Discovery timer is at 00/3:00; enrichment follows ~20 minutes later.
OnCalendar=*-*-* 00/3:20:00
Persistent=false
RandomizedDelaySec=3min
AccuracySec=1min
Unit=vplayer-enrichpending.service

[Install]
WantedBy=timers.target
